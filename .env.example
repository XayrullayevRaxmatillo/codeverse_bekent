# ---- Server ----
NODE_ENV=development
PORT=5000
# Frontend manzili (CORS va email havolalari uchun).
# Bir nechta bo'lsa vergul bilan; birinchisi email/sertifikat havolalarida ishlatiladi:
# CLIENT_URL=https://codeverse.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# Lokal: mongodb://127.0.0.1:27017/codeverse
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codeverse?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codeverse

# ---- Auth ----
# Kamida 32 belgili tasodifiy satr. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Frontend boshqa domenda bo'lsa (masalan Vercel + Render): none (HTTPS shart). Bitta domen: lax
COOKIE_SAMESITE=lax

# ---- AI mentor (ixtiyoriy) ----
# anthropic | openai  (bo'sh qoldirilsa AI o'chiq, sayt ishlayveradi)
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- Email (ixtiyoriy) ----
# Bo'sh bo'lsa parolni tiklash havolasi server konsoliga chiqariladi (faqat development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CODEVERSE <no-reply@codeverse.local>"

# ---- Seed: demo akkaunt (faqat development) ----
SEED_DEMO=true
DEMO_EMAIL=demo@codeverse.dev
DEMO_PASSWORD=Demo12345!
ADMIN_EMAIL=admin@codeverse.dev
ADMIN_PASSWORD=Admin12345!
